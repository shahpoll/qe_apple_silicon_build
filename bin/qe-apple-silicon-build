#!/usr/bin/env bash
set -euo pipefail
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR=$(cd -P -- "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" = /* ]] || SOURCE="$DIR/$SOURCE"
done
ROOT_DIR=$(cd -P -- "$(dirname "$SOURCE")/.." && pwd)
PYTHON="${QE_PYTHON:-python3}"
export PYTHONDONTWRITEBYTECODE=1
cmd="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$cmd" in
  doctor) exec "$PYTHON" "$ROOT_DIR/scripts/doctor.py" "$@" ;;
  install|update) exec "$PYTHON" "$ROOT_DIR/scripts/install_qe.py" "$@" ;;
  check|validate) exec "$PYTHON" "$ROOT_DIR/scripts/validate_build.py" "$@" ;;
  activate|rollback) exec "$PYTHON" "$ROOT_DIR/scripts/activate_qe.py" "$@" ;;
  status) exec "$PYTHON" "$ROOT_DIR/scripts/status.py" "$@" ;;
  smoke) exec "$PYTHON" "$ROOT_DIR/scripts/smoke_test.py" "$@" ;;
  compare) exec "$PYTHON" "$ROOT_DIR/scripts/compare_runs.py" "$@" ;;
  physical) exec "$PYTHON" "$ROOT_DIR/scripts/physical_checks.py" "$@" ;;
  examples) exec "$PYTHON" "$ROOT_DIR/scripts/example_validation.py" "$@" ;;
  davidson) exec "$PYTHON" "$ROOT_DIR/scripts/davidson_validation.py" "$@" ;;
  workflow) exec "$PYTHON" "$ROOT_DIR/scripts/workflow.py" "$@" ;;
  convergence) exec "$PYTHON" "$ROOT_DIR/cases/si/convergence/run_convergence.py" "$@" ;;
  upstream) exec "$PYTHON" "$ROOT_DIR/scripts/upstream_validation.py" "$@" ;;
  help|-h|--help)
    cat <<'EOF'
Usage: qe-apple-silicon-build <doctor|install|update|check|smoke|workflow|compare|physical|examples|davidson|convergence|upstream|activate|rollback|status> [options]
Install/update uses curl and existing tools; no Homebrew is required or invoked.
Every run retains separate logs and typed results outside the installed package.
Use '<command> --help' for exact options. Installation candidates remain inactive
unless --activate is explicitly selected after the declared qualification passes.
EOF
    ;;
  *) echo "Unknown command: $cmd" >&2; exit 2 ;;
esac
